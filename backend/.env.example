# Melolist-v3 backend 환경변수 예시 (복사해서 .env 로 사용, .env 는 커밋 금지)

# --- Supabase PostgreSQL ---
SUPABASE_DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- Supabase Auth (JWT 검증, 비대칭 서명키의 JWKS) ---
# 예: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=

# --- CORS (프론트 오리진, 콤마 구분) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- ACRCloud (서버 전용 — 프론트 노출 금지) ---
# identify 호스트. 지문/허밍 프로젝트 리전 동일(ap-southeast-1)
ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
# 지문(fingerprint) 프로젝트 키
FINGERPRINT_API_KEY=
FINGERPRINT_API_SECRET=
# 허밍(humming) 프로젝트 키
HUMMING_API_KEY=
HUMMING_API_SECRET=
# Metadata API 토큰 (유튜브 videoId·커버 보강용, 프로젝트별 2개)
METADATA_API_KEY_MUSIC=
METADATA_API_KEY_HUMMING=

# --- Server ---
PORT=8080

# --- (선택) ACRCloud 목업 모드 — 실호출 없이 검색 파이프라인 테스트 ---
# 실행 시 SPRING_PROFILES_ACTIVE=acr-mock 을 함께 주면 identify/Metadata가 목업으로 대체된다.
# 시나리오 전환(기본 hit): hit | nomatch | lowscore | error
#ACR_MOCK_SCENARIO=hit
