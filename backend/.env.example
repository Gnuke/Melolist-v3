# Melolist-v3 backend 환경변수 예시 (복사해서 .env 로 사용, .env 는 커밋 금지)

# --- Supabase PostgreSQL ---
SUPABASE_DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- Supabase Auth (JWT 검증, 비대칭 서명키의 JWKS) ---
# 예: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=

# --- CORS (프론트 오리진, 콤마 구분) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server ---
PORT=8080
