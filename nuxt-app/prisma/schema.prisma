generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id              BigInt    @id @default(autoincrement()) @map("user_id")
  provider        String    @db.VarChar(20) @map("provider")
  providerUserId  String    @db.VarChar(128) @map("provider_user_id")
  displayName     String?   @db.VarChar(100) @map("display_name")
  reviewHideUntil DateTime? @map("review_hide_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  board Board?

  @@unique([provider, providerUserId], name: "uk_provider_user")
  @@map("wooriic_user")
}

model Board {
  id        BigInt   @id @default(autoincrement()) @map("board_id")
  userId    BigInt   @unique @map("user_id")
  rating    Int
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wooriic_board")
}
